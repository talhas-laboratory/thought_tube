{
  "chat_backend": "openclaw_gateway",
  "openclaw": {
    "agent": "thought_tube_router",
    "thinking": "low",
    "timeout_seconds": 60,
    "deliver": false
  },
  "model_roles": {
    "dimension_local_fast": {
      "backend": "openclaw_gateway",
      "model_id": "moonshot/kimi-k2.5",
      "enabled": true,
      "fallback_role_id": "",
      "endpoint": "",
      "attributes": {
        "purpose": "Fast evidence-posture classification routed through an OpenClaw agent.",
        "agent": "inner_world_dimension_fast",
        "thinking": "off",
        "timeout_seconds": 20
      }
    },
    "dimension_local_semantic": {
      "backend": "openclaw_gateway",
      "model_id": "moonshot/kimi-k2.5",
      "enabled": true,
      "fallback_role_id": "dimension_local_fast",
      "endpoint": "",
      "attributes": {
        "purpose": "Semantic enrichment for intent, tension, and lens extraction through OpenClaw.",
        "agent": "inner_world_dimension_semantic",
        "thinking": "low",
        "timeout_seconds": 30
      }
    },
    "dimension_remote_judge": {
      "backend": "openclaw_gateway",
      "model_id": "moonshot/kimi-k2.5",
      "enabled": true,
      "fallback_role_id": "dimension_local_semantic",
      "endpoint": "",
      "attributes": {
        "purpose": "Escalation-only arbitration and difficult semantic judgment through OpenClaw.",
        "agent": "inner_world_dimension_judge",
        "thinking": "low",
        "timeout_seconds": 45
      }
    },
    "pond_router_local": {
      "backend": "",
      "model_id": "",
      "enabled": false,
      "fallback_role_id": "",
      "endpoint": "",
      "attributes": {
        "purpose": "Local-first pond router for chunk/project/domain basin classification."
      }
    },
    "pond_router_judge": {
      "backend": "",
      "model_id": "",
      "enabled": false,
      "fallback_role_id": "pond_router_local",
      "endpoint": "",
      "attributes": {
        "purpose": "Escalation-only pond routing judge for ambiguous or multi-pond chunks."
      }
    }
  },
  "pond_router": {
    "enabled": true,
    "mode": "heuristic",
    "assisted_on_ambiguity": true,
    "allow_manual_override": true,
    "ambiguity_threshold": 0.72,
    "local_role_id": "pond_router_local",
    "judge_role_id": "pond_router_judge",
    "router_version": "v1"
  },
  "knowledge": {
    "fail_empty_admission_shadow_v1": true,
    "fail_empty_admission_enforce_v1": true
  },
  "disclosure": {
    "estimator_version": "1.0",
    "reservation_version": "1.0",
    "orientation_max_chars": 480,
    "budget_reservations": {
      "system_tokens": 120,
      "answer_tokens": 256,
      "orientation_max_tokens": 120
    },
    "persistent_receipts_v1": false,
    "receipts": {
      "persistent_receipts_v1": false,
      "max_entries": 500,
      "retention_days": 30
    },
    "active_state": {
      "continuity_v1": false,
      "max_transitions": 200
    }
  },
  "holodeck": {
    "disclosure_service_v1": false,
    "contextualization_retrieval_limit": 6,
    "contextualization_neighbor_limit": 4
  },
  "bridge": {
    "enabled": true,
    "agent": "thought_tube_router",
    "model": "moonshot/kimi-k2.5",
    "thinking": "low",
    "timeout_seconds": 25,
    "fallback": "heuristic",
    "emit_heuristic_preview": true,
    "execution_mode": "agent",
    "execution_audit_isolation_v1": true,
    "effective_grant_normalization_v1": true,
    "deterministic_budget_enforcement_v1": true,
    "orient_first_compose_v1": true,
    "disclosure_service_v1": false,
    "openclaw_mode": "auto",
    "tracking": {
      "require_active_session": true,
      "default_context_mode": "session_only",
      "max_turn_window": 12,
      "retention": {
        "max_stored_turns": 200,
        "max_user_text_chars": 12000,
        "max_assistant_text_chars": 16000,
        "compact_after_turns": 150,
        "ledger_tail_entries": 5000,
        "max_events_per_session": 400,
        "slim_control_packets": true
      },
      "element_context": {
        "max_provisional_captures": 5,
        "max_promoted_records": 8,
        "allow_cross_element": false,
        "min_capture_chars": 40,
        "min_capture_confidence": 0.6,
        "auto_apply_on_session_end": false
      },
      "default_session_binding": {
        "element_key": "frontend",
        "holodeck_id": "sol-frontend",
        "subproject_id": "sol-frontend-mobile-capture"
      }
    }
  },
  "self_improvement": {
    "enabled": false,
    "agent": "thought_tube_self_improve",
    "model": "moonshot/kimi-k2.5",
    "thinking": "high",
    "timeout_seconds": 90,
    "default_authority": "propose",
    "allow_production_deploy": false,
    "config_path": "product/inner_world_v1/config/self_improvement.json",
    "agent_config_path": "product/inner_world_v1/config/agent_configs/thought_tube_self_improve.json"
  },
  "telegram_meta": {
    "enabled": false,
    "agent": "inner_space_meta",
    "default_state": "discuss",
    "allow_production_deploy": false,
    "require_explicit_approval": true,
    "agent_config_path": "product/inner_world_v1/config/agent_configs/inner_space_meta.json"
  }
}
