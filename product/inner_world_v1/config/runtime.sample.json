{
  "chat_backend": "heuristic",
  "world_studio": {
    "visual_embeddings": {
      "model": "google/gemini-embedding-2-preview",
      "api_key": ""
    }
  },
  "openclaw": {
    "agent": "main",
    "thinking": "minimal",
    "timeout_seconds": 90,
    "deliver": false
  },
  "bridge": {
    "enabled": true,
    "agent": "thought_tube_router",
    "model": "moonshot/kimi-k2.5",
    "thinking": "low",
    "timeout_seconds": 25,
    "fallback": "heuristic",
    "emit_heuristic_preview": true,
    "execution_mode": "agent",
    "execution_audit_isolation_v1": true,
    "effective_grant_normalization_v1": true,
    "deterministic_budget_enforcement_v1": true,
    "openclaw_mode": "auto"
  },
  "knowledge": {
    "fail_empty_admission_shadow_v1": true,
    "fail_empty_admission_enforce_v1": true
  },
  "disclosure": {
    "estimator_version": "1.0",
    "reservation_version": "1.0",
    "budget_reservations": {
      "system_tokens": 120,
      "answer_tokens": 256,
      "orientation_max_tokens": 120
    }
  },
  "self_improvement": {
    "enabled": false,
    "agent": "thought_tube_self_improve",
    "model": "moonshot/kimi-k2.5",
    "thinking": "high",
    "timeout_seconds": 90,
    "default_authority": "propose",
    "allow_production_deploy": false,
    "config_path": "product/inner_world_v1/config/self_improvement.json",
    "agent_config_path": "product/inner_world_v1/config/agent_configs/thought_tube_self_improve.json"
  },
  "telegram_meta": {
    "enabled": false,
    "agent": "inner_space_meta",
    "default_state": "discuss",
    "allow_production_deploy": false,
    "require_explicit_approval": true,
    "agent_config_path": "product/inner_world_v1/config/agent_configs/inner_space_meta.json"
  }
}
