{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mtsf://schemas/assertion-store",
  "title": "AssertionStore",
  "description": "Layer T1: typed assertions and evidence bundles with substrate anchors. Source-derived; immutable after materialize unless re-ingested.",
  "type": "object",
  "required": ["version", "session_id", "draft_id", "substrate_ref", "evidence_bundles", "assertions"],
  "properties": {
    "version": { "type": "string" },
    "session_id": { "type": "string" },
    "draft_id": { "type": "string" },
    "subgraph_id": { "type": "string" },
    "substrate_ref": {
      "type": "string",
      "description": "Path to immutable session events.jsonl"
    },
    "raw_content_ref": {
      "type": "string",
      "description": "Optional path to preserved full transcript file"
    },
    "materialized_at": { "type": "string", "format": "date-time" },
    "evidence_bundles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/evidence_bundle_record" }
    },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion_record" }
    }
  },
  "$defs": {
    "substrate_anchor": {
      "type": "object",
      "required": ["event_id", "char_start", "char_end"],
      "properties": {
        "event_id": { "type": "string" },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 0 },
        "span_index": { "type": "integer", "minimum": 0 },
        "excerpt": { "type": "string" }
      }
    },
    "evidence_bundle_record": {
      "type": "object",
      "required": ["id", "spans"],
      "properties": {
        "id": { "type": "string" },
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/substrate_anchor" }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "assertion_record": {
      "type": "object",
      "required": ["id", "kind", "subject_ref", "detail_level", "evidence_bundle_id"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "entity",
            "quality",
            "quality_role",
            "relation",
            "candidate_shape",
            "stencil_draft"
          ]
        },
        "subject_ref": {
          "type": "string",
          "description": "Canonical handle: entity id, quality id, relation id, etc."
        },
        "payload": {
          "type": "object",
          "description": "Kind-specific slim record for T2 projection"
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "detail_level": {
          "type": "string",
          "enum": ["handle", "identity", "configuration", "evidence", "substrate"]
        },
        "facet_completeness": {
          "type": "object",
          "properties": {
            "identity": { "type": "boolean" },
            "configuration": { "type": "boolean" },
            "evidence": { "type": "boolean" },
            "substrate": { "type": "boolean" },
            "causal_geometry": { "type": "boolean" },
            "temporal_dynamics": { "type": "boolean" },
            "constraint_landscape": { "type": "boolean" },
            "cybernetic_feedback": { "type": "boolean" }
          }
        },
        "evidence_bundle_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["proposed", "validated", "quarantined"],
          "default": "proposed"
        }
      }
    }
  }
}
