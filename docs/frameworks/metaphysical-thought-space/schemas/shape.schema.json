{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mtsf://schemas/shape",
  "title": "Shape",
  "description": "A quality-relational configuration: stored profile or live activation.",
  "type": "object",
  "required": ["id", "name", "kind"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["stored", "live", "candidate", "latent"]
    },
    "entity_id": { "type": "string" },
    "selected_qualities": {
      "type": "array",
      "items": { "$ref": "quality-assignment.schema.json" }
    },
    "relation_configuration": {
      "type": "array",
      "items": { "$ref": "relation.schema.json" }
    },
    "intensity_weights": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "context": { "type": "string" },
    "stencil_id": {
      "type": "string",
      "description": "Reference to domain-agnostic stencil core (v1.1)"
    },
    "domain_skin": {
      "type": "string",
      "description": "Domain-specific surface layer; stripped for cross-domain match"
    },
    "dynamics_class": {
      "type": "string",
      "enum": [
        "feedback_reinforcing",
        "feedback_balancing",
        "bottleneck",
        "reservoir",
        "gradient",
        "equilibrium",
        "collapse",
        "oscillation",
        "tight_coupling",
        "star_topology",
        "mesh_topology",
        "hierarchy",
        "other"
      ]
    },
    "symmetry_profile": {
      "type": "string",
      "enum": [
        "symmetric",
        "antisymmetric",
        "asymmetric",
        "chiral",
        "broken_symmetry",
        "mixed",
        "unknown"
      ]
    },
    "problem_signal": {
      "type": "boolean",
      "default": false,
      "description": "True when shape represents a roadblock configuration"
    },
    "scale": {
      "type": "string",
      "enum": [
        "micro", "scene", "project", "identity", "cultural", "metaphysical"
      ]
    },
    "abstraction": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "stability": { "type": "string" },
    "possible_names": { "type": "array", "items": { "type": "string" } },
    "promoted_to_entity_id": {
      "type": "string",
      "description": "If shape stabilized into its own entity"
    }
  }
}
