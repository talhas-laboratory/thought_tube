{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mtsf://schemas/analogical-match",
  "title": "AnalogicalMatch",
  "description": "Cross-domain structural match with slot diff and translation proposal. Quarantined until promoted.",
  "type": "object",
  "required": ["id", "problem_stencil_id", "match_stencil_id", "structural_score"],
  "properties": {
    "id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["provisional", "quarantined", "promoted", "rejected"],
      "default": "quarantined"
    },
    "problem_stencil_id": { "type": "string" },
    "problem_entity_id": { "type": "string" },
    "match_stencil_id": { "type": "string" },
    "match_shape_instance_id": { "type": "string" },
    "match_entity_id": { "type": "string" },
    "match_subgraph_id": { "type": "string" },
    "structural_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "semantic_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "orthogonal": {
      "type": "boolean",
      "description": "True when semantic similarity is low but structural score is high"
    },
    "match_mode": {
      "type": "string",
      "enum": ["positive_isomorph", "antisymmetric_shadow", "negative_inference"],
      "default": "positive_isomorph"
    },
    "slot_diff": {
      "type": "array",
      "description": "Roles/relations present in match but missing in problem",
      "items": {
        "type": "object",
        "properties": {
          "slot_type": { "type": "string" },
          "present_in_match": { "type": "boolean" },
          "present_in_problem": { "type": "boolean" },
          "foreign_label": { "type": "string" },
          "translated_label": { "type": "string" }
        }
      }
    },
    "translation_proposal": {
      "type": "string",
      "description": "Domain-specific re-instantiation narrative (model-generated, code-quarantined)"
    },
    "bounding_box_constraints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "For negative inference: what the solution must NOT do"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
