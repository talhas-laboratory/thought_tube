{
  "id": "inner-world-long-form-expanded-content",
  "title": "Inner World Long-Form Expanded Content Blueprint",
  "version": "v1",
  "default_profile": "explainer_default",
  "style_posture": "structured_explainer_with_optional_narrative_opening",
  "user_adjustable": true,
  "reorderable": true,
  "selected_algorithms": [
    "signal-frame-extractor",
    "object-model-projection",
    "transformation-path-extractor",
    "decision-commitment-extractor",
    "guardrail-antigoal-extractor",
    "tension-map-extractor",
    "evidence-confidence-scaffold",
    "open-question-missingness-extractor",
    "reasoning-primitive-detector"
  ],
  "conditional_algorithms": [
    "contradiction-pair-extractor"
  ],
  "modules": [
