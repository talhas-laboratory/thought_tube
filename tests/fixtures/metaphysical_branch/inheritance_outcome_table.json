          "membership_kind": "asserted",
          "effective_scope_id": "scope_org",
          "introduced_by": "service:interpretation",
          "membership_provenance_id": "prov_mem_005"
        },
        {
          "record_id": "cl_shared_003",
          "branch_id": "branch_child_c",
          "membership_kind": "asserted",
          "effective_scope_id": "scope_org",
          "introduced_by": "service:revision",
          "membership_provenance_id": "prov_mem_006"
        }
