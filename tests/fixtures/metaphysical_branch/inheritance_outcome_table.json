      }
    },
    {
      "case_id": "inherit-007",
      "description": "Child retracts; parent ancestor still has the record. Retraction shadows all ancestors.",
      "record_id": "cl_deep_001",
      "record_kind": "claim",
      "child_branch_id": "branch_grandchild",
      "branch_ancestry": [
        {"branch_id": "branch_grandchild", "parent_branch_id": "branch_child_a"},
        {"branch_id": "branch_child_a", "parent_branch_id": "branch_main"},
        {"branch_id": "branch_main", "parent_branch_id": ""}
      ],
      "membership_entries": [
        {
          "record_id": "cl_deep_001",
          "branch_id": "branch_main",
          "membership_kind": "asserted",
          "effective_scope_id": "scope_org",
          "introduced_by": "service:interpretation",
          "membership_provenance_id": "prov_mem_007"
        },
        {
          "record_id": "cl_deep_001",
          "branch_id": "branch_grandchild",
          "membership_kind": "retracted",
          "effective_scope_id": "scope_org",
