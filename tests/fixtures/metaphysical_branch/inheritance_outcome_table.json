        "visibility": "absent",
        "effective_membership_kind": null,
        "resolved_in_branch_id": null
      }
    },
    {
      "case_id": "inherit-006",
      "description": "Branch-neutral source fragment readable in any branch without membership check",
      "record_id": "sf_neutral_001",
      "record_kind": "source_fragment",
      "child_branch_id": "branch_child_a",
      "branch_ancestry": [
        {"branch_id": "branch_child_a", "parent_branch_id": "branch_main"},
        {"branch_id": "branch_main", "parent_branch_id": ""}
