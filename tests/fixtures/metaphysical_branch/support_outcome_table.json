      "description": "One affirmative claim in scope — supported_only",
      "branch_id": "branch_main",
      "scope_id": "scope_org",
      "claim_proposition": {"predicate": "causes", "arguments": ["control_loss", "initiative_drop"]},
      "include_inherited": false,
      "evidence_claims": [
        {
          "id": "cl_aff_001",
          "branch_id": "branch_main",
          "scope_id": "scope_org",
          "polarity": "affirmative",
          "proposition": {"predicate": "causes", "arguments": ["control_loss", "initiative_drop"]}
        }
      ],
      "expected": {
        "support_value": "supported_only",
        "affirmative_claim_ids": ["cl_aff_001"],
        "negative_claim_ids": []
      }
    },
    {
      "case_id": "support-002",
      "description": "One negative claim in scope and no affirmative — opposed_only",
      "branch_id": "branch_main",
      "scope_id": "scope_org",
      "claim_proposition": {"predicate": "causes", "arguments": ["control_loss", "initiative_drop"]},
      "include_inherited": false,
      "evidence_claims": [
        {
          "id": "cl_neg_001",
          "branch_id": "branch_main",
          "scope_id": "scope_org",
          "polarity": "negative",
          "proposition": {"predicate": "causes", "arguments": ["control_loss", "initiative_drop"]}
        }
      ],
      "expected": {
        "support_value": "opposed_only",
        "affirmative_claim_ids": [],
        "negative_claim_ids": ["cl_neg_001"]
      }
    },
    {
      "case_id": "support-003",
      "description": "Both affirmative and negative claims in same scope — both (no explosion)",
      "branch_id": "branch_main",
      "scope_id": "scope_org",
      "claim_proposition": {"predicate": "causes", "arguments": ["control_loss", "initiative_drop"]},
      "include_inherited": false,
      "evidence_claims": [
        {
          "id": "cl_aff_002",
          "branch_id": "branch_main",
          "scope_id": "scope_org",
          "polarity": "affirmative",
          "proposition": {"predicate": "causes", "arguments": ["control_loss", "initiative_drop"]}
        },
        {
          "id": "cl_neg_002",
          "branch_id": "branch_main",
          "scope_id": "scope_org",
          "polarity": "negative",
