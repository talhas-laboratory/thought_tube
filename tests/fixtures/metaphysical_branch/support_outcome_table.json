          "id": "cl_parent_aff_001",
          "branch_id": "branch_main",
          "scope_id": "scope_org",
          "polarity": "affirmative",
          "proposition": {"predicate": "causes", "arguments": ["control_loss", "initiative_drop"]},
          "membership_kind": "asserted"
